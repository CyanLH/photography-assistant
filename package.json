{
  "name": "photography-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 8080",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 8080",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/app src/components src/state src/domains scripts tests next.config.ts",
    "test": "node scripts/build-test.mjs && node --test reference/*.test.mjs tests/*.test.mjs",
    "test:e2e": "node qa/next-browser.mjs",
    "build:prototype": "node scripts/build.mjs",
    "format:check": "prettier --check \"src/app/**/*.{ts,tsx,css}\" \"src/components/**/*.{ts,tsx}\" \"src/state/**/*.{ts,tsx}\" next.config.ts eslint.config.js"
  },
  "devDependencies": {
    "@types/google.maps": "3.58.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "astronomy-engine": "2.1.19",
    "esbuild": "0.25.9",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@photostructure/tz-lookup": "11.7.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
